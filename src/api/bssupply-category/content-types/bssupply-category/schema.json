{
  "kind": "collectionType",
  "collectionName": "bssupply_categories",
  "info": {
    "singularName": "bssupply-category",
    "pluralName": "bssupply-categories",
    "displayName": "Bssupply - Category",
    "description": "Bssupply product category"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "sortOrder": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::bssupply-product.bssupply-product",
      "mappedBy": "category"
    }
  }
}
