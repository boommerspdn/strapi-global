{
  "kind": "collectionType",
  "collectionName": "bprservice_brands",
  "info": {
    "singularName": "bprservice-brand",
    "pluralName": "bprservice-brands",
    "displayName": "BPRService - Brand",
    "description": "Air conditioning brands"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "favicon": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "sortOrder": {
      "type": "integer",
      "default": 0,
      "min": 0
    },
    "wallUnit": {
      "type": "boolean",
      "default": false
    },
    "floorUnit": {
      "type": "boolean",
      "default": false
    },
    "ceilingCassette": {
      "type": "boolean",
      "default": false
    },
    "hangingUnit": {
      "type": "boolean",
      "default": false
    },
    "products": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::bprservice-product.bprservice-product",
      "mappedBy": "brand"
    }
  }
}
